# ============================================================
# DevSync Production Environment Configuration Template
# Copy this file to .env and configure appropriate values
# DO NOT COMMIT SENSITIVE SECRETS TO SOURCE CONTROL
# ============================================================

# ─── Server Configuration ─────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ─── PostgreSQL Database (Prisma) ─────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devsync?schema=public"

# ─── JWT Authentication & Token Expiry ─────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-access-token-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-token-key-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── CORS & Origin Configuration ──────────────────────────────
# Comma-separated list of allowed frontend origins (e.g. Next.js, Expo Web)
CLIENT_URL="http://localhost:3000,http://localhost:8081"
WEB_ORIGIN="http://localhost:3000,http://localhost:8081"

# ─── Cloud Object Storage (S3 / Cloudflare R2 / Local Fallback) ──
# Options: 's3', 'r2', 'cloudinary', 'local'
STORAGE_PROVIDER="local"
MAX_FILE_SIZE_MB=25

# Cloudflare R2 / AWS S3 Settings (Leave empty for local fallback)
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="devsync-files"
STORAGE_ACCESS_KEY="your-storage-access-key-id"
STORAGE_SECRET_KEY="your-storage-secret-access-key"
STORAGE_PUBLIC_URL="https://pub-<hash>.r2.dev"

# Cloudinary Settings (Alternative provider)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ─── Next.js Web Frontend (apps/web/.env.local) ───────────────
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# ─── React Native Mobile App (apps/mobile/.env) ──────────────
EXPO_PUBLIC_API_URL="http://localhost:5000"
EXPO_PUBLIC_SOCKET_URL="http://localhost:5000"
